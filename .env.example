# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Paths and mock API (already used by src/config.py) ---
# DB_PATH=db/backlog.db
MOCK_API_URL=http://127.0.0.1:8000
# Pin the mock API's "now" to a moment, e.g. during the Shah Alam spike. Leave unset for end of day 30.
# MOCK_API_AS_OF=2026-01-12 10:00:00

# --- LLM: Google Gemini (week 2 onwards). Get a key at https://aistudio.google.com ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Telegram approval flow (week 4) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-supervisor-chat-id-here
